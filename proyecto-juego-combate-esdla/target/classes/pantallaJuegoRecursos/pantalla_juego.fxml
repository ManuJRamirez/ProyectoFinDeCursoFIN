<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.text.TextFlow?>


<StackPane fx:id="contenedorPrincipal"
	xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
	fx:controller="learning.tokioschool.proyectoJuegoCombateEsdla.grafico.PantallaJuegoControlador">
	<children>

		<!-- CAPA 1 (FONDO): El mapa y su Canvas estirable -->
		<AnchorPane fx:id="contenedorCanvas">
			<children>
				<Canvas fx:id="canvasMapa" AnchorPane.bottomAnchor="0.0"
					AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
					AnchorPane.topAnchor="0.0" />
			</children>
		</AnchorPane>

		<!-- CABECERA SUPERIOR IZQUIERDA: CONTENEDOR DESPLEGABLE DEL LOG -->
		<HBox fx:id="contenedorLogFlotante" alignment="TOP_LEFT"
			maxWidth="-Infinity" maxHeight="-Infinity" spacing="0.0"
			StackPane.alignment="TOP_LEFT">
			<StackPane.margin>
				<Insets top="20.0" left="20.0" />
			</StackPane.margin>
			<children>
				<StackPane>
					<children>
						<ScrollPane fx:id="scrollLog" hbarPolicy="NEVER"
							vbarPolicy="AS_NEEDED" fitToWidth="true" prefWidth="380.0"
							prefHeight="260.0" maxWidth="-Infinity" maxHeight="-Infinity"
							style="-fx-background: rgba(15, 20, 30, 0.75); -fx-background-color: transparent; -fx-border-color: rgba(58, 134, 255, 0.4); -fx-border-width: 1.5; -fx-border-radius: 4 0 0 4; -fx-background-radius: 4 0 0 4;">
							<content>
								<TextFlow fx:id="flowLog" prefWidth="365.0"
									style="-fx-background-color: transparent; -fx-padding: 8;" />
							</content>
						</ScrollPane>

						<!-- ===== REDIMENSIONADO: grip inferior-derecho para ampliar el panel 
							(hasta un 50% más) -->
						<Region fx:id="resizeGripLog" prefWidth="16.0"
							prefHeight="16.0" maxWidth="16.0" maxHeight="16.0"
							StackPane.alignment="BOTTOM_RIGHT"
							style="-fx-cursor: se-resize; -fx-background-color: linear-gradient(to bottom right, transparent 50%, rgba(58,134,255,0.6) 50%); -fx-background-radius: 0 0 4 0;" />

					</children>
				</StackPane>

				<Button fx:id="btnAlternarLog" mnemonicParsing="false"
					onAction="#alternarVisibilidadPanelLog" prefHeight="35.0"
					prefWidth="25.0"
					style="-fx-background-color: rgba(40, 45, 55, 0.9); -fx-text-fill: #ffd700; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-color: rgba(58, 134, 255, 0.4); -fx-border-width: 1.5 1.5 1.5 0; -fx-border-radius: 0 4 4 0; -fx-background-radius: 0 4 4 0; -fx-cursor: hand;"
					text="◀" />
			</children>
		</HBox>

		<!-- CABECERA SUPERIOR DERECHA: CONTENEDOR DESPLEGABLE DEL LOG DE DADOS -->
		<HBox fx:id="contenedorLogDados" alignment="TOP_RIGHT"
			maxWidth="-Infinity" maxHeight="-Infinity" spacing="0.0"
			StackPane.alignment="TOP_RIGHT">
			<StackPane.margin>
				<Insets top="20.0" right="20.0" />
			</StackPane.margin>
			<children>
				<Button fx:id="btnAlternarLogDados" mnemonicParsing="false"
					onAction="#alternarVisibilidadPanelLogDados" prefHeight="35.0"
					prefWidth="25.0"
					style="-fx-background-color: rgba(40, 45, 55, 0.9); -fx-text-fill: #ffd700; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-color: rgba(255, 51, 51, 0.4); -fx-border-width: 1.5 0 1.5 1.5; -fx-border-radius: 4 0 0 4; -fx-background-radius: 4 0 0 4; -fx-cursor: hand;"
					text="▶" />

				<StackPane>
					<children>
						<ScrollPane fx:id="scrollLogDados" hbarPolicy="NEVER"
							vbarPolicy="AS_NEEDED" fitToWidth="true" prefWidth="380.0"
							prefHeight="260.0" maxWidth="-Infinity" maxHeight="-Infinity"
							style="-fx-background: rgba(15, 20, 30, 0.75); -fx-background-color: transparent; -fx-border-color: rgba(255, 51, 51, 0.4); -fx-border-width: 1.5; -fx-border-radius: 0 4 4 0; -fx-background-radius: 0 4 4 0;">
							<content>
								<TextFlow fx:id="flowLogDados" prefWidth="365.0"
									style="-fx-background-color: transparent; -fx-padding: 8;" />
							</content>
						</ScrollPane>

						<!--.REDIMENSIONADO: grip inferior-izquierdo para ampliar el panel 
							(hasta un 50% más) -->
						<Region fx:id="resizeGripLogDados" prefWidth="16.0"
							prefHeight="16.0" maxWidth="16.0" maxHeight="16.0"
							StackPane.alignment="BOTTOM_LEFT"
							style="-fx-cursor: sw-resize; -fx-background-color: linear-gradient(to bottom left, transparent 50%, rgba(255,51,51,0.6) 50%); -fx-background-radius: 0 0 0 4;" />
					</children>
				</StackPane>
			</children>
		</HBox>

		<!-- CABECERA SUPERIOR: PUNTUACIÓN DE CADA BANDO FLANQUEANDO LA BARRA DE 
			TURNOS. -->
		<HBox alignment="TOP_CENTER" spacing="20.0" maxWidth="-Infinity"
			maxHeight="-Infinity" StackPane.alignment="TOP_CENTER">
			<StackPane.margin>
				<Insets top="15.0" />
			</StackPane.margin>
			<children>

				<!-- placa de puntuación de los Heroes -->
				<HBox fx:id="hboxPuntosHeroes" alignment="CENTER_LEFT"
					spacing="0.0" maxWidth="-Infinity" maxHeight="-Infinity"
					style="-fx-background-color: rgba(25, 30, 40, 0.85); -fx-border-color: #3a86ff; -fx-border-width: 1.5; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5 16 5 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 8, 0, 0, 4);">
					<children>
						<Label
							style="-fx-text-fill: #3a86ff; -fx-font-size: 13px; -fx-font-weight: bold;"
							text="⚔️ Heroes: " />
						<Label fx:id="lblPuntosHeroes"
							style="-fx-text-fill: #3a86ff; -fx-font-size: 14px; -fx-font-weight: 900;"
							text="0" />
					</children>
				</HBox>
				<HBox fx:id="hboxTropasHeroes" alignment="CENTER_LEFT"
					spacing="0.0" maxWidth="-Infinity" maxHeight="-Infinity"
					style="-fx-background-color: rgba(25, 30, 40, 0.85); -fx-border-color: #3a86ff; -fx-border-width: 1.5; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5 16 5 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 8, 0, 0, 4);">
					<children>
						<Label
							style="-fx-text-fill: #3a86ff; -fx-font-size: 13px; -fx-font-weight: bold;"
							text="🧍 Tropas: " />
						<Label fx:id="lblTropasHeroes"
							style="-fx-text-fill: #3a86ff; -fx-font-size: 14px; -fx-font-weight: 900;"
							text="0/0" />
					</children>
				</HBox>

				<!-- Barra de turno + botón únicamente -->
				<VBox alignment="TOP_CENTER" maxWidth="-Infinity"
					maxHeight="-Infinity" spacing="8.0">
					<children>
						<HBox alignment="CENTER" spacing="0.0" prefWidth="300.0"
							maxWidth="-Infinity" minWidth="-Infinity"
							style="-fx-background-color: rgba(25, 30, 40, 0.85); -fx-border-color: rgba(255, 215, 0, 0.3); -fx-border-width: 1.5; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 20 6 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 8, 0, 0, 4);">
							<children>
								<Label
									style="-fx-text-fill: #b0b5c0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Helvetica, sans-serif;"
									text="TURNO " />
								<Label fx:id="lblRondaPartida"
									style="-fx-text-fill: #ffd700; -fx-font-size: 15px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Helvetica, sans-serif;"
									text="1" />
								<Label fx:id="lblLimiteTurnos"
									style="-fx-text-fill: #b0b5c0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Helvetica, sans-serif;"
									text="" />
								<Label
									style="-fx-text-fill: rgba(255,255,255,0.15); -fx-font-size: 14px; -fx-padding: 0 15 0 15;"
									text="•" />
								<Label
									style="-fx-text-fill: #b0b5c0; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Helvetica, sans-serif;"
									text="FASE: " />
								<Label fx:id="lblTurno"
									style="-fx-text-fill: #00ff66; -fx-font-size: 14px; -fx-font-weight: 900; -fx-font-family: 'Segoe UI', Helvetica, sans-serif;"
									text="HÉROES" />
							</children>
						</HBox>

						<Button fx:id="btnFinalizarTurno" mnemonicParsing="false"
							onAction="#finalizarTurnoPulsado"
							style="-fx-background-color: rgba(35, 40, 50, 0.9); -fx-text-fill: #ffd700; -fx-font-weight: bold; -fx-font-size: 14px; -fx-border-color: #ffd700; -fx-border-width: 1.2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 6 18 6 18; -fx-cursor: hand;"
							text="⏳ Finalizar Turno" />
					</children>
				</VBox>

				<HBox fx:id="hboxTropasBestias" alignment="CENTER_RIGHT"
					spacing="0.0" maxWidth="-Infinity" maxHeight="-Infinity"
					style="-fx-background-color: rgba(25, 30, 40, 0.85); -fx-border-color: #ff3333; -fx-border-width: 1.5; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5 16 5 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 8, 0, 0, 4);">
					<children>
						<Label
							style="-fx-text-fill: #ff3333; -fx-font-size: 13px; -fx-font-weight: bold;"
							text="🧍 Tropas: " />
						<Label fx:id="lblTropasBestias"
							style="-fx-text-fill: #ff3333; -fx-font-size: 14px; -fx-font-weight: 900;"
							text="0/0" />
					</children>
				</HBox>

				<!-- placa de puntuación de las Bestias -->
				<HBox fx:id="hboxPuntosBestias" alignment="CENTER_RIGHT"
					spacing="0.0" maxWidth="-Infinity" maxHeight="-Infinity"
					style="-fx-background-color: rgba(25, 30, 40, 0.85); -fx-border-color: #ff3333; -fx-border-width: 1.5; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5 16 5 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 8, 0, 0, 4);">
					<children>
						<Label
							style="-fx-text-fill: #ff3333; -fx-font-size: 13px; -fx-font-weight: bold;"
							text="🔥 Bestias: " />
						<Label fx:id="lblPuntosBestias"
							style="-fx-text-fill: #ff3333; -fx-font-size: 14px; -fx-font-weight: 900;"
							text="0" />
					</children>
				</HBox>

			</children>
		</HBox>
		<VBox alignment="TOP_CENTER" maxWidth="-Infinity"
			maxHeight="-Infinity" spacing="8.0" StackPane.alignment="TOP_CENTER">
			<StackPane.margin>
				<Insets top="115.0" />
			</StackPane.margin>
			<children>
				<Label fx:id="lblEstadoTurno"
					style="-fx-text-fill: #ff3333; -fx-font-weight: bold; -fx-font-size: 26px; -fx-effect: dropshadow(three-pass-box, black, 5, 1, 0, 0);"
					text="👹 Las Bestias planean su estrategia..." />

				<TextFlow fx:id="lblAnuncioConquista" visible="false"
					managed="false" prefWidth="720.0" maxWidth="720.0" minWidth="0.0"
					textAlignment="CENTER"
					style="-fx-effect: dropshadow(three-pass-box, black, 5, 1, 0, 0);" />
			</children>
		</VBox>

		<!-- PANEL ALIADO (Esquina Inferior Izquierda) -->
		<VBox fx:id="panelAliado" managed="false" visible="false"
			prefWidth="280.0" maxWidth="-Infinity" maxHeight="-Infinity"
			spacing="6.0"
			style="-fx-background-color: rgba(20, 45, 90, 0.85); -fx-border-color: #3a86ff; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12;"
			StackPane.alignment="BOTTOM_LEFT">
			<StackPane.margin>
				<Insets bottom="20.0" left="20.0" />
			</StackPane.margin>
			<children>
				<HBox fx:id="hboxCabeceraAliado" alignment="CENTER_LEFT"
					maxWidth="1.0E30">
					<children>
						<Label
							style="-fx-text-fill: #3a86ff; -fx-font-weight: bold; -fx-font-size: 15px;"
							text="⚔️ UNIDAD ALIADA" />
						<Region HBox.hgrow="ALWAYS" />
						<Button mnemonicParsing="false"
							onAction="#cerrarPanelAliado"
							style="-fx-background-color: #3a86ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 1 7 2 7; -fx-cursor: hand; -fx-background-radius: 3;"
							text="X" />
					</children>
				</HBox>
				<Label fx:id="lblAliadoNombre"
					style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 2 0 0 0;"
					text="Nombre: -" />
				<Label fx:id="lblAliadoTipo"
					style="-fx-text-fill: white; -fx-font-size: 14px;" text="Clase: -" />
				<HBox alignment="CENTER_LEFT" spacing="0">
					<Label fx:id="lblAliadoArmadura"
						style="-fx-text-fill: white; -fx-font-size: 14px;"
						text="Armadura: -" />
					<Label fx:id="lblesVisible"
						style="-fx-text-fill: #aaffcc; -fx-font-size: 13px; -fx-font-weight: bold;"
						text="" visible="false" managed="false" />
				</HBox>
				<StackPane alignment="CENTER_LEFT" prefHeight="22.0">
					<children>
						<ProgressBar fx:id="barAliadoVida" prefWidth="260.0"
							progress="0.0"
							style="-fx-accent: #00ff66; -fx-control-inner-background: rgba(0,0,0,0.5);" />
						<Label fx:id="lblAliadoVida"
							style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 0 0 10; -fx-effect: dropshadow(three-pass-box, black, 3, 1, 0, 0);"
							text="HP: -/-" />
					</children>
				</StackPane>
				<Label fx:id="lblAliadoTurnoInmovil" wrapText="true"
					maxWidth="256.0" visible="false" managed="false"
					style="-fx-text-fill: #ff6644; -fx-font-size: 13px; -fx-font-weight: bold;"
					text="" />
				<Label fx:id="lblAliadoBonus" wrapText="true" maxWidth="256.0"
					style="-fx-text-fill: #ffe27a; -fx-font-size: 12px; -fx-padding: 4 0 0 0;"
					text="" />

				<Region VBox.vgrow="ALWAYS" />
			</children>
		</VBox>

		<!-- PANEL CENTRAL: INFORMACIÓN DE TERRENO Y CIUDAD -->
		<VBox fx:id="panelInfoCasilla" prefWidth="320.0"
			prefHeight="-Infinity" maxWidth="-Infinity" maxHeight="-Infinity"
			spacing="6.0"
			style="-fx-background-color: rgba(30, 30, 30, 0.88); -fx-border-color: #ffffff; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12;"
			StackPane.alignment="BOTTOM_CENTER">
			<StackPane.margin>
				<Insets bottom="20.0" />
			</StackPane.margin>
			<children>
				<Label fx:id="lblCabeceraCasilla"
					style="-fx-text-fill: #b0b0b0; -fx-font-weight: bold; -fx-font-size: 15px;"
					text="🗺️ DATOS DE REGION" />
				<Label fx:id="lblInfoTerreno"
					style="-fx-text-fill: white; -fx-font-size: 14px;"
					text="Terreno: -" />
				<Label fx:id="lblInfoFrontera"
					style="-fx-text-fill: #c8c8c8; -fx-font-size: 14px;"
					text="Soberanía: -" />

				<VBox fx:id="subPanelCiudad" spacing="5.0" visible="false"
					managed="false"
					style="-fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1 0 0 0; -fx-padding: 6 0 0 0;">
					<children>
						<Label fx:id="lblCiudadNombre"
							style="-fx-text-fill: #ffd700; -fx-font-weight: bold; -fx-font-size: 14px;"
							text="Ciudad: -" />
						<Label fx:id="lblCiudadControl"
							style="-fx-text-fill: #fff3a0; -fx-font-size: 14px;"
							text="Poseedor: -" />
						<Label fx:id="lblCiudadEstadoConquista"
							style="-fx-font-weight: bold; -fx-font-size: 13px;" text=""
							wrapText="true" prefWidth="290.0" maxWidth="290.0" minWidth="0.0" />
						<Label
							style="-fx-text-fill: #a0a0a0; -fx-font-size: 12px; -fx-font-weight: bold;"
							text="GUARNICIÓN (Haz clic para seleccionar):" />
						<ListView fx:id="listGuarnicionUrbana" prefHeight="65.0"
							minHeight="65.0"
							style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-font-size: 13px; -fx-border-color: rgba(255,255,255,0.1);" />

						<VBox fx:id="vboxReclutamiento" spacing="4.0" visible="false"
							managed="false"
							style="-fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1 0 0 0; -fx-padding: 6 0 0 0;" />
					</children>
				</VBox>
			</children>
		</VBox>

		<!-- PANEL ENEMIGO (Esquina Inferior Derecha) -->
		<VBox fx:id="panelEnemigo" managed="false" visible="false"
			prefWidth="280.0" maxWidth="-Infinity" maxHeight="-Infinity"
			spacing="6.0"
			style="-fx-background-color: rgba(90, 20, 20, 0.85); -fx-border-color: #ff0055; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 12;"
			StackPane.alignment="BOTTOM_RIGHT">
			<StackPane.margin>
				<Insets bottom="20.0" right="20.0" />
			</StackPane.margin>
			<children>
				<HBox fx:id="hboxCabeceraEnemigo" alignment="CENTER_RIGHT"
					maxWidth="1.0E30">
					<children>
						<Button mnemonicParsing="false"
							onAction="#cerrarPanelEnemigo"
							style="-fx-background-color: #ff0055; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 1 7 2 7; -fx-cursor: hand; -fx-background-radius: 3;"
							text="X" />
						<Region HBox.hgrow="ALWAYS" />
						<Label
							style="-fx-text-fill: #ff0055; -fx-font-weight: bold; -fx-font-size: 15px;"
							text="🔥 UNIDAD ENEMIGA" />
					</children>
				</HBox>
				<Label fx:id="lblEnemigoNombre"
					style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 2 0 0 0;"
					text="Nombre: -" />
				<Label fx:id="lblEnemigoTipo"
					style="-fx-text-fill: white; -fx-font-size: 14px;" text="Clase: -" />
				<Label fx:id="lblEnemigoArmadura"
					style="-fx-text-fill: white; -fx-font-size: 14px;"
					text="Armadura: -" />
				<StackPane alignment="CENTER_LEFT" prefHeight="22.0">
					<children>
						<ProgressBar fx:id="barEnemigoVida" prefWidth="260.0"
							progress="0.0"
							style="-fx-accent: #ff0055; -fx-control-inner-background: rgba(0,0,0,0.5);" />
						<Label fx:id="lblEnemigoVida"
							style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 0 0 10; -fx-effect: dropshadow(three-pass-box, black, 3, 1, 0, 0);"
							text="HP: -/-" />
					</children>
				</StackPane>
				<Label fx:id="lblEnemigoBonus" wrapText="true"
					maxWidth="256.0"
					style="-fx-text-fill: #ffb347; -fx-font-size: 12px; -fx-padding: 4 0 4 0;"
					text="" />
				<Button fx:id="btnAtacar" maxWidth="1.0E30"
					mnemonicParsing="false" onAction="#ejecutarAtaque"
					style="-fx-background-color: #ff0055; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"
					text="¡ATACAR!" />
			</children>
		</VBox>

	</children>
</StackPane>
