<?xml version="1.0" encoding="UTF-8"?>
 
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<GridPane maxHeight="-Infinity" maxWidth="-Infinity"
	minHeight="-Infinity" minWidth="-Infinity" prefHeight="890.0"
	prefWidth="800.0" xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="learning.tokioschool.proyectoJuegoCombateEsdla.menuPrincipal.MenuPrincipalControlador">
	<columnConstraints>
		<ColumnConstraints hgrow="SOMETIMES"
			maxWidth="-Infinity" minWidth="50.0" prefWidth="50.0" />
		<ColumnConstraints hgrow="SOMETIMES"
			maxWidth="-Infinity" minWidth="10.0" prefWidth="100.0" />
		<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"
			prefWidth="100.0" />
		<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"
			prefWidth="100.0" />
		<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"
			prefWidth="100.0" />
		<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"
			prefWidth="100.0" />
		<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"
			prefWidth="100.0" />
		<ColumnConstraints hgrow="SOMETIMES"
			maxWidth="-Infinity" minWidth="50.0" prefWidth="50.0" />
	</columnConstraints>
	<rowConstraints>
		<!-- fila 0: margen superior -->
		<RowConstraints maxHeight="-Infinity" minHeight="30.0"
			prefHeight="30.0" vgrow="NEVER" />
		<!-- fila 1: título -->
		<RowConstraints maxHeight="-Infinity" minHeight="70.0"
			prefHeight="70.0" vgrow="NEVER" />
		<!-- fila 2: etiquetas Heroes / Orcos -->
		<RowConstraints maxHeight="-Infinity" minHeight="30.0"
			prefHeight="30.0" vgrow="NEVER" />
		<!-- fila 3: listas de paladines (sin rowSpan) -->
		<RowConstraints maxHeight="-Infinity" minHeight="280.0"
			prefHeight="280.0" vgrow="NEVER" />
		<!-- fila 4: mensaje "selecciona al menos..." (fila propia, ya no se solapa 
			con la lista) -->
		<RowConstraints maxHeight="-Infinity" minHeight="35.0"
			prefHeight="35.0" vgrow="NEVER" />
		<!-- fila 5: campos de turnos / puntos máximos -->
		<RowConstraints maxHeight="-Infinity" minHeight="50.0"
			prefHeight="50.0" vgrow="NEVER" />
		<!-- fila 6: dificultad de la IA -->
		<RowConstraints maxHeight="-Infinity" minHeight="40.0"
			prefHeight="40.0" vgrow="NEVER" />
		<!-- fila 7: checkboxes de condiciones de victoria -->
		<RowConstraints maxHeight="-Infinity" minHeight="250.0"
			prefHeight="250.0" vgrow="NEVER" />
		<!-- fila 8: botón empezar partida -->
		<RowConstraints maxHeight="-Infinity" minHeight="60.0"
			prefHeight="60.0" vgrow="NEVER" />
		<!-- fila 9: margen inferior -->
		<RowConstraints maxHeight="-Infinity" minHeight="30.0"
			prefHeight="30.0" vgrow="NEVER" />
	</rowConstraints>
	<fx:define>
		<ToggleGroup fx:id="grupoDificultad" />
	</fx:define>
	<children>
		<Label text="El señor de las Argollas" GridPane.columnIndex="1"
			GridPane.columnSpan="6" GridPane.halignment="CENTER"
			GridPane.rowIndex="1" GridPane.valignment="CENTER">
			<font>
				<Font name="System Bold" size="40.0" />
			</font>
		</Label>

		<HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1"
			GridPane.columnSpan="3" GridPane.halignment="CENTER"
			GridPane.rowIndex="2" GridPane.valignment="BOTTOM">
			<children>
				<Label text="Heroes">
					<font>
						<Font name="System Bold" size="20.0" />
					</font>
				</Label>
				<CheckBox fx:id="chkSeleccionarTodosHeroes"
					mnemonicParsing="false" text="Seleccionar todos" />
			</children>
		</HBox>
		<HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="4"
			GridPane.columnSpan="3" GridPane.halignment="CENTER"
			GridPane.rowIndex="2" GridPane.valignment="BOTTOM">
			<children>
				<Label text="Bestias">
					<font>
						<Font name="System Bold" size="20.0" />
					</font>
				</Label>
				<CheckBox fx:id="chkSeleccionarTodosBestias"
					mnemonicParsing="false" text="Seleccionar todos" />
			</children>
		</HBox>

		<ListView fx:id="listaHeroes" maxHeight="-Infinity"
			maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
			prefHeight="270.0" prefWidth="336.0" GridPane.columnIndex="1"
			GridPane.columnSpan="3" GridPane.rowIndex="3"
			GridPane.valignment="TOP">
			<GridPane.margin>
				<Insets top="5.0" />
			</GridPane.margin>
		</ListView>
		<ListView fx:id="listaBestias" maxHeight="-Infinity"
			maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
			prefHeight="270.0" prefWidth="336.0" GridPane.columnIndex="4"
			GridPane.columnSpan="3" GridPane.rowIndex="3"
			GridPane.valignment="TOP">
			<GridPane.margin>
				<Insets right="10.0" top="5.0" />
			</GridPane.margin>
		</ListView>

		<Label text="Selecciona al menos 5 Heroes y 5 Orcos"
			GridPane.columnIndex="1" GridPane.columnSpan="6"
			GridPane.halignment="CENTER" GridPane.rowIndex="4"
			GridPane.valignment="CENTER">
			<font>
				<Font size="16.0" />
			</font>
		</Label>

		<HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1"
			GridPane.columnSpan="6" GridPane.halignment="CENTER"
			GridPane.rowIndex="5" GridPane.valignment="CENTER">
			<children>
				<Label text="Nº máximo de turnos:">
					<font>
						<Font size="14.0" />
					</font>
				</Label>
				<TextField fx:id="txtTurnosMaximos" prefWidth="60.0"
					promptText="20" />
				<Label text="Nº máximo de puntos:">
					<font>
						<Font size="14.0" />
					</font>
				</Label>
				<TextField fx:id="txtPuntosMaximos" prefWidth="60.0"
					promptText="15" />
				<Label text="Nº máximo de tropas:">
					<font>
						<Font size="14.0" />
					</font>
				</Label>
				<TextField fx:id="txtTropasMaximas" prefWidth="60.0"
					promptText="0 - 25" />
			</children>
		</HBox>

		<HBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="1"
			GridPane.columnSpan="6" GridPane.halignment="CENTER"
			GridPane.rowIndex="6" GridPane.valignment="CENTER">
			<children>
				<Label text="Dificultad IA:">
					<font>
						<Font size="14.0" />
					</font>
				</Label>
				<RadioButton fx:id="radioDificultadFacil"
					mnemonicParsing="false" text="Fácil" toggleGroup="$grupoDificultad" />
				<RadioButton fx:id="radioDificultadNormal"
					mnemonicParsing="false" selected="true" text="Normal"
					toggleGroup="$grupoDificultad" />
				<RadioButton fx:id="radioDificultadDificil"
					mnemonicParsing="false" text="Difícil"
					toggleGroup="$grupoDificultad" />
			</children>
		</HBox>

		<VBox alignment="CENTER_LEFT" spacing="10.0"
			GridPane.columnIndex="2" GridPane.columnSpan="4"
			GridPane.halignment="CENTER" GridPane.rowIndex="7"
			GridPane.valignment="TOP">
			<children>
				<Label text="¿Cómo se puede ganar la partida?">
					<font>
						<Font name="System Bold" size="14.0" />
					</font>
				</Label>
				<CheckBox fx:id="chkPuntosAlFinalizarTurnos"
					mnemonicParsing="false"
					text="Gana quien cumpla la segunda condición al agotarse el número máximo de turnos"
					wrapText="true" />
				<CheckBox fx:id="chkLimiteDePuntos" mnemonicParsing="false"
					text="Gana quien llegue antes al número máximo de puntos"
					wrapText="true" />
				<CheckBox fx:id="chkFrodoMonteDelDestino"
					mnemonicParsing="false"
					text="Ganan los Heroes si &quot;Frodo&quot; llega al Monte del Destino"
					wrapText="true" />
				<CheckBox fx:id="chkFrodoEliminado" mnemonicParsing="false"
					text="Ganan las Bestias si eliminan a &quot;Frodo&quot;"
					wrapText="true" />
				<CheckBox fx:id="chkDominio" mnemonicParsing="false"
					text="Gana quien conquiste todas las ciudades del enemigo (Dominio)"
					wrapText="true" />

			</children>
		</VBox>

		<Button fx:id="btnEmpezarPartida" mnemonicParsing="false"
			onAction="#empezarPartida" prefHeight="50.0" prefWidth="207.0"
			text="¡¡Empezar partida!!" GridPane.columnIndex="1"
			GridPane.columnSpan="6" GridPane.halignment="CENTER"
			GridPane.rowIndex="8" GridPane.valignment="CENTER">
			<font>
				<Font size="20.0" />
			</font>
		</Button>
	</children>
</GridPane>